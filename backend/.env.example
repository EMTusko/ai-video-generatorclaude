# MongoDB Configuration
# Leave MONGO_URL empty to use a built-in in-memory database (data is lost on restart)
MONGO_URL=
DB_NAME=ai_video_generator

# JWT Secret for Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Video Generation API Keys
# Get a key at https://dev.runwayml.com - leave empty to run in demo mode (sample media)
RUNWAY_API_KEY=
# Optional: Runway model, aspect ratio and polling
# RUNWAY_TEXT_MODEL=gen4.5
# RUNWAY_IMAGE_MODEL=gen4.5
# RUNWAY_RATIO=1280:720

STABILITY_API_KEY=your_stability_api_key_here
PIKA_API_KEY=your_pika_api_key_here

# Admin Configuration
ADMIN_EMAILS=admin@example.com,creator@example.com

# App Configuration
MAX_FILE_SIZE=50MB
MAX_VIDEOS_PER_USER=100
VIDEO_STORAGE_PATH=./uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001

# Environment
NODE_ENV=development
DEBUG=true
